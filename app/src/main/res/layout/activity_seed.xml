<?xml version="1.0" encoding="utf-8"?>
<!-- Cette vue represente la saisie de la graine !-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/fond_ecran_retro"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/container"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/fond_panneau_retro"
        android:padding="24dp">

    <TextView
        android:id="@+id/question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:textColor="@color/ui_text"
        android:textSize="@dimen/text_size"
        android:text="Veuillez entrez la graine s'il vous plait ?"
        android:textStyle="bold"
        />

    <EditText
        android:id="@+id/champ_graine"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fond_champ_retro"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:padding="14dp"
        android:textColor="@color/ui_text"
        android:textColorHint="@color/ui_score"
        android:hint="Entrez la graine"
        />

    </LinearLayout>

</RelativeLayout>
