<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond_ecran_jeu">

    <ImageView
        android:id="@+id/imgFondJeu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.10"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/logo" />

    <LinearLayout
        android:id="@+id/contenuJeu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_contenu_jeu_h"
        android:paddingTop="22dp"
        android:paddingEnd="@dimen/padding_contenu_jeu_h"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/fond_bandeau_jeu"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_bandeau_jeu_h"
            android:paddingTop="@dimen/padding_bandeau_jeu_v"
            android:paddingEnd="@dimen/padding_bandeau_jeu_h"
            android:paddingBottom="@dimen/padding_bandeau_jeu_v">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:text="Score : 0"
                    android:textColor="@color/ui_game_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCoups"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coups : 0"
                    android:textColor="@color/ui_game_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtSeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Seed : 0"
                android:textColor="@color/ui_game_text_soft"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/fond_grille_jeu"
            android:orientation="vertical"
            android:padding="@dimen/padding_cadre_grille">

            <GridLayout
                android:id="@+id/grilleJeu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="6"
                android:rowCount="6" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlayFin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtOverlayFinTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/fond_bandeau_jeu"
            android:paddingStart="22dp"
            android:paddingTop="12dp"
            android:paddingEnd="22dp"
            android:paddingBottom="12dp"
            android:text="@string/overlay_fin_titre"
            android:textColor="@color/ui_game_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtOverlayFinSeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/fond_bandeau_jeu"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:textColor="@color/ui_game_text_soft"
            android:textSize="16sp" />
    </LinearLayout>

</RelativeLayout>
