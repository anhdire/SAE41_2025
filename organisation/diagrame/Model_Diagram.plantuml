@startuml Model_Diagram
skinparam classAttributeIconSize 0

!define MODEL_COLOR #D0E6FF

package "Modele" {

class MoteurJeu MODEL_COLOR {
  - grille: Grille
  - scoreManager: GestionScore
  - verrouManager: GestionVerrou
  - generateur: Generateur
  - score: int
  - nbCoup: int
  - finie: boolean
  - modeDur: boolean
  - seed: long
  --
  + MoteurJeu(seed: long, modeDur: boolean)
  + jouerCoup(estLigne: boolean, index: int, decalage: int): void
  + setSeed(seed: long): void
  + estFinie(): boolean
  + getScore(): int
  + getNbCoup(): int
  + getGrille(): Grille
  + getSeed(): long
  + isModeDur(): boolean
  + sauvegarder(contexte: Context): void
  + restaurer(contexte: Context): boolean
  + effacerSauvegarde(contexte: Context): void
}

class Grille MODEL_COLOR {
  - cases: Case[][]
  - generateur: Generateur
  --
  + Grille(taille: int, seed: long)
  + initialiser(): void
  + glisserLigne(index: int, decalage: int): Case[]
  + glisserColonne(index: int, decalage: int): Case[]
  + detecterSeries(): List<Serie>
  + supprimerSeries(series: List<Serie>): void
  + appliquerGravite(): void
  + remplir(): void
  + estStable(): boolean
  + estVide(): boolean
  + existeCoupPossible(): boolean
  + aUneCaseMystere(): boolean
  + ajouterCaseMystere(generateur: Generateur): void
  + getCases(): Case[][]
  + versTexte(): String
  + chargerDepuisTexte(texte: String): void
}

class Case MODEL_COLOR {
  - type: TypeElement
  - verrouille: boolean
  - mystere: boolean
  --
  + Case(type: TypeElement)
  + getType(): TypeElement
  + setType(type: TypeElement): void
  + isVerrouille(): boolean
  + isMystere(): boolean
  + verrouiller(): void
  + deverrouiller(): void
  + rendreMystere(): void
  + enleverMystere(): void
}

class Serie MODEL_COLOR {
  - positions: List<Position>
  --
  + Serie()
  + addPosition(position: Position): void
  + getPositions(): List<Position>
  + longueur(): int
}

class Position MODEL_COLOR {
  - ligne: int
  - colonne: int
  --
  + Position(ligne: int, colonne: int)
  + getLigne(): int
  + getColonne(): int
}

class GestionScore MODEL_COLOR {
  + calculerScore(series: List<Serie>, n: int): int
}

class GestionVerrou MODEL_COLOR {
  - generateur: Generateur
  - modeDur: boolean
  --
  + GestionVerrou(seed: long, modeDur: boolean)
  + ajouterVerrouSiNecessaire(grille: Grille, nbCoups: int): void
}

class Generateur MODEL_COLOR {
  - random: Random
  --
  + Generateur(seed: long)
  + typeAleatoire(): TypeElement
  + entierAleatoire(borneExclusive: int): int
}

enum TypeElement MODEL_COLOR {
  ROUGE
  BLEU_OCEAN
  VERT
  ORANGE
  VIOLET
  JAUNE
  BLEU_CIEL
}

}

MoteurJeu --> Grille
MoteurJeu --> GestionScore
MoteurJeu --> GestionVerrou
MoteurJeu --> Generateur

Grille --> Case
Grille --> Serie
Grille --> Generateur
Serie --> Position
Case --> TypeElement
GestionVerrou --> Grille
GestionVerrou --> Generateur
GestionScore --> Serie
Generateur --> TypeElement

@enduml
