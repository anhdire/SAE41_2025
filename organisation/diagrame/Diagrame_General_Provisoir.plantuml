@startuml Diagrame_Generale_Provisoir
skinparam classAttributeIconSize 0

!define MODEL_COLOR #D0E6FF
!define VIEW_COLOR #D5F5D5
!define CONTROLLER_COLOR #FFE0B3
!define LISTENER_COLOR #DDDDDD

' ==============================
' MODEL
' ==============================

package "Model" {

class MoteurJeu MODEL_COLOR {
  - grille: Grille
  - scoreManager: ScoreManager
  - verrouManager: VerrouManager
  - generateur: Generateur
  - score: int
  - nbCoups: int
  - finie: boolean
  - seed: long
  --
  + jouerCoup(estLigne: boolean, index: int, decalage: int): void
  + estFinie(): boolean
  + getScore(): int
  + getNbCoups(): int
  + getGrille(): Grille
}

class Grille MODEL_COLOR {
  - cases: Case[][]
  - generateur: Generateur
  --
  + initialiser(): void
  + glisserLigne(index: int, decalage: int): void
  + glisserColonne(index: int, decalage: int): void
  + detecterSeries(): List<Serie>
  + supprimerSeries(series: List<Serie>): void
  + appliquerGravite(): void
  + remplir(): void
  + estStable(): boolean
  + existeCoupPossible(): boolean
}

class Case MODEL_COLOR {
  - type: TypeElement
  - verrouille: boolean
  --
  + getType(): TypeElement
  + setType(type: TypeElement): void
  + estVerrouille(): boolean
  + verrouiller(): void
  + deverrouiller(): void
}

class Serie MODEL_COLOR {
  - positions: List<Position>
  --
  + longueur(): int
  + getPositions(): List<Position>
}

class Position MODEL_COLOR {
  - ligne: int
  - colonne: int
  --
  + getLigne(): int
  + getColonne(): int
}

class ScoreManager MODEL_COLOR {
  + calculerScore(series: List<Serie>): int
}

class VerrouManager MODEL_COLOR {
  - generateur: Generateur
  --
  + ajouterVerrouSiNecessaire(grille: Grille, nbCoups: int): void
}

class Generateur MODEL_COLOR {
  - random: Random
  --
  + Generateur(seed: long)
  + typeAleatoire(): TypeElement
}

enum TypeElement MODEL_COLOR

}

' ==============================
' VIEW
' ==============================

package "View" {

class MenuActivity VIEW_COLOR
class JeuActivity VIEW_COLOR
class OptionsActivity VIEW_COLOR
class SeedActivity VIEW_COLOR

interface ElementRenderer VIEW_COLOR {
  + getDrawable(type: TypeElement): Drawable
}

class NormalRenderer VIEW_COLOR
class DaltonienRenderer VIEW_COLOR

}

' ==============================
' CONTROLLER
' ==============================

package "Controller" {

class MenuController CONTROLLER_COLOR {
  + demarrerPartieNormale(): void
  + demarrerPartieDestinee(seed: long): void
  + ouvrirOptions(): void
}

class JeuController CONTROLLER_COLOR {
  - moteur: MoteurJeu
  --
  + glisserLigne(index: int, decalage: int): void
  + glisserColonne(index: int, decalage: int): void
  + verifierFin(): boolean
}

class OptionsController CONTROLLER_COLOR {
  + activerHardMode(actif: boolean): void
  + activerModeDaltonien(actif: boolean): void
}

class MenuClickListener LISTENER_COLOR
class JeuTouchListener LISTENER_COLOR
class OptionsSwitchListener LISTENER_COLOR

}

' ==============================
' RELATIONS
' ==============================

MoteurJeu --> Grille
MoteurJeu --> ScoreManager
MoteurJeu --> VerrouManager
MoteurJeu --> Generateur

Grille --> Case
Grille --> Serie
Serie --> Position
Case --> TypeElement

JeuController --> MoteurJeu
MenuController --> MoteurJeu

JeuActivity --> JeuController
MenuActivity --> MenuController
OptionsActivity --> OptionsController
SeedActivity --> MenuController

JeuActivity --> ElementRenderer
ElementRenderer <|-- NormalRenderer
ElementRenderer <|-- DaltonienRenderer

MenuClickListener --> MenuController
JeuTouchListener --> JeuController
OptionsSwitchListener --> OptionsController

@enduml