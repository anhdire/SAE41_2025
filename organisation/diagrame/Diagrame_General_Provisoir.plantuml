@startuml Diagrame_Generale_Provisoir
skinparam classAttributeIconSize 0

!define MODEL_COLOR #D0E6FF
!define VIEW_COLOR #D5F5D5
!define CONTROLLER_COLOR #FFE0B3

package "Modele" {

class MoteurJeu MODEL_COLOR {
  - grille: Grille
  - scoreManager: GestionScore
  - verrouManager: GestionVerrou
  - generateur: Generateur
  - score: int
  - nbCoup: int
  - finie: boolean
  - modeDur: boolean
  - seed: long
  --
  + jouerCoup(estLigne: boolean, index: int, decalage: int): void
  + estFinie(): boolean
  + getScore(): int
  + getNbCoup(): int
  + getGrille(): Grille
  + getSeed(): long
  + isModeDur(): boolean
  + sauvegarder(contexte: Context): void
  + restaurer(contexte: Context): boolean
}

class Grille MODEL_COLOR {
  - cases: Case[][]
  - generateur: Generateur
  --
  + initialiser(): void
  + glisserLigne(index: int, decalage: int): Case[]
  + glisserColonne(index: int, decalage: int): Case[]
  + detecterSeries(): List<Serie>
  + supprimerSeries(series: List<Serie>): void
  + appliquerGravite(): void
  + remplir(): void
  + existeCoupPossible(): boolean
  + aUneCaseMystere(): boolean
  + ajouterCaseMystere(generateur: Generateur): void
}

class Case MODEL_COLOR {
  - type: TypeElement
  - verrouille: boolean
  - mystere: boolean
}

class Serie MODEL_COLOR
class Position MODEL_COLOR
class GestionScore MODEL_COLOR
class GestionVerrou MODEL_COLOR
class Generateur MODEL_COLOR
enum TypeElement MODEL_COLOR

}

package "Vues" {

class ActiviteMenu VIEW_COLOR
class ActiviteGraine VIEW_COLOR
class ActiviteJeu VIEW_COLOR
class ActiviteOptions VIEW_COLOR
class VueCase VIEW_COLOR
interface AfficheurElement VIEW_COLOR
class AfficheurNormal VIEW_COLOR

}

package "Controleurs et ecouteurs" {

class ControleMenu CONTROLLER_COLOR
class ControleJeu CONTROLLER_COLOR
class ControleOptions CONTROLLER_COLOR
class EcouteurMenu CONTROLLER_COLOR
class EcouteurGraine CONTROLLER_COLOR
class EcouteurCase CONTROLLER_COLOR
class EcouteurModeDur CONTROLLER_COLOR
class ObservateurPreferences CONTROLLER_COLOR

}

MoteurJeu --> Grille
MoteurJeu --> GestionScore
MoteurJeu --> GestionVerrou
MoteurJeu --> Generateur

Grille --> Case
Grille --> Serie
Grille --> Generateur
Serie --> Position
Case --> TypeElement
GestionVerrou --> Grille
GestionVerrou --> Generateur
GestionScore --> Serie
Generateur --> TypeElement

ActiviteMenu --> ControleMenu
ActiviteMenu --> EcouteurMenu

ActiviteGraine --> EcouteurGraine
EcouteurGraine --> ActiviteGraine

ActiviteJeu --> ControleJeu
ActiviteJeu --> VueCase
ActiviteJeu --> AfficheurElement
AfficheurElement <|-- AfficheurNormal
EcouteurCase --> ControleJeu
EcouteurCase --> ActiviteJeu
VueCase --> TypeElement

ActiviteOptions --> ControleOptions
ActiviteOptions --> ObservateurPreferences
EcouteurModeDur --> ControleOptions
ObservateurPreferences --> ActiviteOptions

ControleJeu --> MoteurJeu
ControleOptions --> ActiviteOptions
ControleMenu --> ActiviteMenu

@enduml
